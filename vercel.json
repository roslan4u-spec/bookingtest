{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server.js" },
    { "source": "/rooms", "destination": "/rooms.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ]
}
